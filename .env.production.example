# =============================================================================
# elxea-agent 本番環境変数テンプレート
#
# このファイルをコピーして .env.production を作成し、実際の値を入力してください。
# .env.production は .gitignore に登録済みです（シークレット漏洩防止）。
#
# 使い方:
#   cp .env.production.example .env.production
#   # 各値を編集
#   source .env.production
#   bash scripts/setup-production.sh
# =============================================================================

# ── LINE Messaging API ──────────────────────────────────────────────────────
# LINE Developers Console > チャネル > Messaging API > チャネルシークレット
LINE_CHANNEL_SECRET=your-line-channel-secret

# LINE Developers Console > チャネル > Messaging API > チャネルアクセストークン（長期）
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token

# ── Anthropic ───────────────────────────────────────────────────────────────
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key

# ── Supabase ────────────────────────────────────────────────────────────────
# Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Firebase / Firestore ────────────────────────────────────────────────────
# Firebase Console > プロジェクト設定 > サービスアカウント > 新しい秘密鍵を生成
# FIREBASE_PRIVATE_KEY: JSON の private_key フィールドをそのまま貼り付け（改行は \n のまま）
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"

# ── Shopify ─────────────────────────────────────────────────────────────────
# Shopify Admin > アプリと販売チャネル > アプリを開発する > アプリを作成
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your-admin-token

# ── LIFF ────────────────────────────────────────────────────────────────────
# scripts/setup-liff.ts を実行して取得する
# 形式: {チャネルID}-{アプリID}
LIFF_ID=1234567890-xxxxxxxx

# ── セキュリティ ─────────────────────────────────────────────────────────────
# /api/sync エンドポイントの認証トークン（ランダムな文字列）
# 生成例: openssl rand -hex 32
SYNC_API_SECRET=your-random-sync-api-secret

# ── オプション ───────────────────────────────────────────────────────────────
# Slack エスカレーション通知 Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# Notion トークン（ナレッジ同期に使用）
NOTION_TOKEN=secret_your-notion-token
NOTION_PRODUCT_LIST_DB_ID=your-db-id
NOTION_SET_MENU_DB_ID=your-db-id
NOTION_TEA_MENU_DB_ID=your-db-id
NOTION_CONTENT_HUB_DB_ID=your-db-id
