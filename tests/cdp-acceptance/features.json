  "features": [
    {
      "id": "F-01",
      "area": "事実の収集 (L0)",
      "name": "出来事を書く口が 1 本に寄っている",
      "criteria": "5 経路が gateway を通り、応答も返り値も変わらず L0 に 1 行積まれる",
      "checks": [
        "unit.gateway",
        "hermetic.gateway-flow",
        "static.ratchet"
      ]
    },
    {
      "id": "F-02",
      "area": "事実の収集 (L0)",
      "name": "知らない出来事を捨てない",
      "criteria": "未知の event_type / channel でも schema_ok=false で保存され、応答は従来どおり",
      "checks": [
        "unit.gateway",
        "hermetic.gateway-flow"
      ]
    },
    {
      "id": "F-03",
      "area": "事実の収集 (L0)",
      "name": "同じ出来事を 2 回受けても 1 行にしかならない",
      "criteria": "冪等キーが効き、同一注文の persona が二重加算されない",
      "checks": [
        "unit.gateway",
        "hermetic.gateway-flow",
        "db.invariants"
      ]
    },
    {
      "id": "F-04",
      "area": "事実の収集 (L0)",
      "name": "積めなかったときは必ず理由が残る",
      "criteria": "未連携・未設定で無言 return する枝が無く、理由付きで数えられる (T-12)",
      "checks": [
        "unit.gateway",
        "hermetic.gateway-flow",
        "hermetic.firestore-gate"
      ]
    },
    {
      "id": "F-05",
      "area": "事実の収集 (L0)",
      "name": "L0 の行に生の識別子が入らない",
      "criteria": "冪等キー・payload に生 LINE userId / email が現れない (E5 / SEC-1)",
      "checks": [
        "unit.gateway",
        "hermetic.gateway-flow"
      ]
    },
    {
      "id": "F-06",
      "area": "事実の収集 (L0)",
      "name": "出来事を送る口が鍵なしで開かない",
      "criteria": "POST /api/events が鍵なし・誤鍵・秘密未設定のいずれでも 401",
      "checks": [
        "hermetic.http-surface"
      ]
    },
    {
      "id": "F-07",
      "area": "事実の収集 (L0)",
      "name": "アンケートの答えが同じ口へ流れる",
      "criteria": "survey の回答が L0 に積まれ、会話の応答は変わらない",
      "checks": [
        "hermetic.survey-flow",
        "unit.gateway"
      ]
    },
    {
      "id": "F-08",
      "area": "事実の収集 (L0)",
      "name": "診断の答えが同じ口へ流れる",
      "criteria": "diagnosis の回答が L0 に積まれ、途中離脱しても積んだ分は残る",
      "checks": [
        "hermetic.diagnosis-funnel",
        "crossrepo.vocabulary"
      ]
    },
    {
      "id": "F-09",
      "area": "事実の収集 (L0)",
      "name": "2 リポの語彙が食い違わない",
      "criteria": "web-app が送る event_type / channel / identifier_kind を cx-agent が全部受理する (D3 / D4)",
      "checks": [
        "crossrepo.vocabulary"
      ]
    },
    {
      "id": "F-10",
      "area": "人の同一性",
      "name": "主体を発行できる (匿名の 1 歩目から)",
      "criteria": "subject_id は ULID・発行制・無意味。同じ鍵からは同じ主体しか出ない",
      "checks": [
        "unit.gateway",
        "dbw.append-only",
        "db.invariants"
      ]
    },
    {
      "id": "F-11",
      "area": "人の同一性",
      "name": "1 つの鍵が 2 人の主体に結ばれない",
