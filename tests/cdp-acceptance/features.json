  "tiers": {
    "static": {
      "label": "静的検査 (型・撤去 ratchet)",
      "requires_env": [],
      "ci": true
    },
    "unit": {
      "label": "単体 (ネットワーク不使用)",
      "requires_env": [],
      "ci": true
    },
    "hermetic": {
      "label": "ハーメティック (Worker をインメモリ起動)",
      "requires_env": [],
      "ci": true
    },
    "crossrepo": {
      "label": "2 リポ突合 (送る側 web-app を読む)",
      "requires_env": [],
      "requires_repo": "../elxea-web-app",
      "requires_repo_file": "lib/cdp/behavior-fact.ts",
      "ci": false,
      "requires_repo_env": "ELXEA_WEB_APP_PATH"
    },
    "db-readonly": {
      "label": "正本 DB 読み取り (既定 = 本番・書き込み不可で接続)",
      "requires_env": [
        "SUPABASE_URL",
        "SUPABASE_DB_PASSWORD"
      ],
      "ci": false
    },
    "db-write": {
      "label": "DB 書込往復 (実行環境は Boss が CDP_DB_TARGET で指定)",
      "requires_env": [
        "CDP_DB_TARGET"
      ],
      "ci": false
    },
    "analytics": {
      "label": "解析リポ (elxea-cdp・ネットワーク不使用)",
      "requires_env": [],
      "requires_repo": "../elxea-cdp",
      "requires_repo_file": "l0-ingest.mjs",
      "ci": false,
      "requires_repo_env": "ELXEA_CDP_PATH"
    }
  },
