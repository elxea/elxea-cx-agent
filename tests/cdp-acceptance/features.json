        "db.invariants",
        "dbw.append-only"
      ]
    },
    {
      "id": "F-12",
      "area": "人の同一性",
      "name": "連携が追記 1 行で表現される",
      "criteria": "subject_links に basis 付きで 1 行追記。向きは正規化され重複しない",
