# LINE Messaging API
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# Claude API
ANTHROPIC_API_KEY=

# Supabase (PostgreSQL + pgvector)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Notion (ナレッジソース)
NOTION_TOKEN=
NOTION_PRODUCT_LIST_DB_ID=
NOTION_SET_MENU_DB_ID=
NOTION_TEA_MENU_DB_ID=
NOTION_CONTENT_HUB_DB_ID=

# Shopify Admin API (注文照会用)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Slack (エスカレーション通知)
SLACK_WEBHOOK_URL=

# 同期 API 認証
# 注意: 2026-08-22 に本番の SYNC_API_SECRET をローテート済み。
# 手元の .dev.vars に残っている値は古い可能性が高いため、ローカル検証の前に本番側と同期すること。
# 現行値の取得元:
#   - 本番 Worker (受け側) : Cloudflare Workers Secrets の SYNC_API_SECRET
#   - 呼び出し側 (elxea-web-app) : Vercel の production 環境変数 SYNC_API_SECRET
# 値そのものはこのファイルにも README にも書かない (コミット禁止)。
SYNC_API_SECRET=

# Web チャットの session_id 署名鍵 (HMAC-SHA256)。**SYNC_API_SECRET とは別鍵**。
# 同期の鍵は「この呼び出しは web-app からだ」しか言わない。session_id が本物かは別の問いで、
# 同じ鍵にすると片方が漏れたときに両方の意味が同時に失われる。
# 送る側 (web-app) と受ける側 (この Worker) で **同じ値** を持つこと。
# 登録先 4 箇所:
#   - Cloudflare Workers Secrets (production) : wrangler secret put CHAT_SESSION_SECRET
#   - Cloudflare Workers Secrets (staging)    : wrangler secret put CHAT_SESSION_SECRET --env staging
#   - Vercel 環境変数 (Production)            : CHAT_SESSION_SECRET
#   - Vercel 環境変数 (Preview)               : CHAT_SESSION_SECRET
# 未設定でもチャットは止まらない (session_id を鍵として使わない = その場限りの会話になる)。
# 値そのものはこのファイルにも README にも書かない (コミット禁止)。
CHAT_SESSION_SECRET=

# Embedding: Cloudflare Workers AI (@cf/baai/bge-m3) を使用
# AI バインディングは wrangler.toml で設定済み（環境変数不要）
